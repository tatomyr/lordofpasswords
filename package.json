{
  "name": "lordofpasswords",
  "version": "1.0.0-rc.1",
  "description": "Password Generator",
  "type": "module",
  "main": "index.html",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "http-server -p 8080 -c-1",
    "lint": "eslint",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "build": "node bin/build.js",
    "prettier:check": "prettier --check \"**/*.{js,html,yaml,css,md}\"",
    "prettier": "prettier --write \"**/*.{js,html,yaml,css,md}\"",
    "fresh": "bash bin/fresh.sh",
    "upgrade": "node bin/upgrade.js",
    "prepare": "husky"
  },
  "author": "tatomyr",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.10"
  }
}
